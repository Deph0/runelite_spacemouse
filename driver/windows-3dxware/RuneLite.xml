<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<AppCfg Default="false" xmlns="" CfgFormatVersion="1.3" ThisFileVersion="2.0">
  <CfgProperties>
    <ID>ID_RuneLite_SpaceMouse</ID>
    <Name>RuneLite</Name>
    <InheritsFromID>ID_Default_KMJ_Cfg</InheritsFromID>
    <Grab>None</Grab>
    <Access>
      <ReadOnly>false</ReadOnly>
      <AllowInheritance>true</AllowInheritance>
      <Hidden>false</Hidden>
      <Ignore>false</Ignore>
    </Access>
  </CfgProperties>
  <AppInfo>
    <Signature>
      <Name>RuneLite</Name>
      <ExecutableName>java.exe</ExecutableName>
      <Transport>KMJ</Transport>
      <WindowClassName>SunAwtFrame</WindowClassName>
    </Signature>
    <Options />
  </AppInfo>
  <AuthorInfo>
    <DriverVersion>17.9.15.121</DriverVersion>
    <Created>
      <Tool>3DxService.exe</Tool>
      <Version>17.9.15.121</Version>
      <Date>2026:11:12:13:0:0:0:0</Date>
      <User>9C06EED8-8933-4AC1-8E0E-DC7311A70A35</User>
    </Created>
    <LastChange>
      <Tool>3DxSmartUi</Tool>
      <Version>1.2.26267.121</Version>
      <Date>2026:11:12:14:0:0:0:0</Date>
      <User>9C06EED8-8933-4AC1-8E0E-DC7311A70A35</User>
    </LastChange>
  </AuthorInfo>
  <Devices>
    <Device>
      <ID>ID_Standard_3D_Mouse</ID>
      <Name>Standard 3D Mouse</Name>
      <CurrentAxisBank>Default</CurrentAxisBank>
      <AxisBank Default="true">
        <ID>Default</ID>
        <Name>STR_DEFAULT_BANK</Name>
        <InheritsFromID />
        <!-- Push left / right: unused -->
        <Axis>
          <Enabled>false</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_X</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
          </Input>
          <Output>
            <ActionID>HIDMultiAxis_X</ActionID>
          </Output>
        </Axis>
        <!-- Push forward / back: disabled.
             This device fires Y together with Rx for the same physical motion,
             so only Rx drives the zoom keys. -->
        <Axis>
          <Enabled>false</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Y</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
          </Input>
          <Output>
            <ActionID>HIDMultiAxis_Y</ActionID>
          </Output>
        </Axis>
        <!-- Lift up / press down: camera zoom in / out (numpad + / numpad -).
             Deadband is higher than the rotation axes because the lift motion
             easily picks up a little tilt.
             Press (Z positive) = zoom out, lift (Z negative) = zoom in, matching
             the push/pull direction of Rx. -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Z</ActionID>
            <Min>0</Min>
            <Max>511</Max>
            <Deadband>150</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>56</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Z</ActionID>
            <Min>-511</Min>
            <Max>0</Max>
            <Deadband>150</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>57</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <!-- Tilt forward / back: camera zoom in / out (numpad + / numpad -) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rx</ActionID>
            <Min>0</Min>
            <Max>511</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>57</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rx</ActionID>
            <Min>-511</Min>
            <Max>0</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>56</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <!-- Tilt left / right: camera pitch (numpad 8 / numpad 2) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Ry</ActionID>
            <Min>0</Min>
            <Max>511</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>60</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Ry</ActionID>
            <Min>-511</Min>
            <Max>0</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>5A</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <!-- Twist left / right: camera yaw (numpad 4 / numpad 6) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rz</ActionID>
            <Min>0</Min>
            <Max>511</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>5C</Key>
            </KeyStroke>
          </Output>
        </Axis>
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rz</ActionID>
            <Min>-511</Min>
            <Max>0</Max>
            <Deadband>60</Deadband>
          </Input>
          <Output>
            <ActionID>KB_Keystroke</ActionID>
            <RepeatStyle>PressAndHold</RepeatStyle>
            <KeyStroke>
              <Key>5E</Key>
            </KeyStroke>
          </Output>
        </Axis>
      </AxisBank>
    </Device>
  </Devices>
</AppCfg>
